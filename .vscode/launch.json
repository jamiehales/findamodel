{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Rust Launch",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "-p",
          "findamodel",
          "--bin",
          "findamodel"
        ],
        "filter": {
          "name": "findamodel",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "FINDAMODEL_DATA_PATH": "debug/data",
        "FINDAMODEL_ENVIRONMENT": "Development",
        "FINDAMODEL_LOG": "findamodel=debug"
      }
    },
    {
      "name": "Frontend: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "yarn@1.22.22",
        "dev"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "serverReadyAction": {
        "pattern": "Local:.*http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Desktop: Tauri Dev",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "desktop-tauri: install",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "yarn@1.22.22",
        "tauri",
        "dev"
      ],
      "cwd": "${workspaceFolder}/desktop-tauri",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Backend + Frontend",
      "configurations": [
        "Backend: Rust Launch",
        "Frontend: Vite Dev Server"
      ],
      "stopAll": true
    }
  ]
}
