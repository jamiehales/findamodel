{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: build",
      "type": "shell",
      "command": "cargo build -p findamodel",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "new",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      },
      "group": "build",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "backend: test",
      "type": "shell",
      "command": "cargo test -p findamodel",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "group": "test",
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "frontend: install",
      "type": "shell",
      "command": "corepack yarn@1.22.22 install",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "data: clear database",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -f debug/data/findamodel.db*"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "data: clear cache",
      "type": "process",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf debug/data/cache"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "desktop-tauri: install",
      "type": "shell",
      "command": "corepack yarn@1.22.22 install",
      "options": {
        "cwd": "${workspaceFolder}/desktop-tauri"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "desktop-tauri: publish",
      "type": "shell",
      "command": "corepack yarn@1.22.22 build",
      "options": {
        "cwd": "${workspaceFolder}/desktop-tauri"
      },
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "desktop-tauri: tauri dev (external backend)",
      "type": "shell",
      "command": "corepack yarn@1.22.22 tauri dev",
      "options": {
        "cwd": "${workspaceFolder}/desktop-tauri",
        "env": {
          "FINDAMODEL_EXTERNAL_BACKEND_URL": "http://127.0.0.1:5000",
          "FINDAMODEL_EXTERNAL_BACKEND_TOKEN": "dev-desktop-token"
        }
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Finished|Running.*tauri"
        }
      }
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "corepack yarn@1.22.22 dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    }
  ]
}
